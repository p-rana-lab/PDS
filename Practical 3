# Practical 3
# Conditional Statements and Loops

number = int(input("Enter a number: "))

# if statement
if number > 0:
    print("Number is positive")

# if-else
if number % 2 == 0:
    print("Number is even")
else:
    print("Number is odd")

# elif
if number > 0:
    print("Positive number")
elif number < 0:
    print("Negative number")
else:
    print("Zero")

# while loop
print("\nWhile Loop")

i = 1

while i <= 5:
    print(i)
    i += 1

# for loop
print("\nFor Loop")

for i in range(1, 6):
    print(i)

# Nested loop
print("\nNested Loop")

for i in range(1, 4):
    for j in range(1, 4):
        print("*", end=" ")
    print()

# break
print("\nBreak")

for i in range(1, 10):
    if i == 5:
        break
    print(i)

# continue
print("\nContinue")

for i in range(1, 6):
    if i == 3:
        continue
    print(i)

# pass
print("\nPass")

for i in range(1, 6):
    if i == 3:
        pass
    print(i)
